# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
.pytest_tmp/

# OS / editor
.DS_Store
Thumbs.db

# JavaScript / Next.js local build artifacts
node_modules/
.next/
.next-dev/

# Secrets - never commit API keys
.env
.env.local
*.key

# Private docs (capstone report, slides) - keep local, off the public repo
docs/*
!docs/REFERENCES.md
*_turnitin_submission.docx

# Large external models (not part of the repo)
*.bin
cc.rw.300*
afroxlmr-kinyarwanda-intent/

# Official third-party training data is downloaded from pinned upstream versions
data/external/ESConv.json

# Reviewer-corrected translations stay local unless reviewer permission is documented
data/translation/nllb_human_reviewed_parallel.csv

# Fine-tuned generator weights (307MB > GitHub 100MB limit) — regenerate via train_local.py / notebook
models/umubyeyi-generator/
models/_gen_ckpt/
models/_generator_smoke/
models/_generator_checkpoints/
reports/_generator_smoke/

# HF Space merged checkpoint (1.1GB, LoRA folded in offline) — regenerate via the merge
# script described in hf_space/README.md; only the Space's own source is version-controlled
hf_space/merged_model/

# local UI screenshots
screenshots/

# local analytics DB (SQLite dev fallback)
umubyeyi_analytics.db
*.db

# downloaded Colab run artifacts (models, checkpoints, figures) — regenerate via the notebook.
# Windows auto-suffixes re-downloads as "umubyeyi_colab_results (1)", "(2)", etc.
umubyeyi_colab_results/
umubyeyi_colab_results*/

# Word lock files for open .docx documents (e.g. ~$ubyeyi_...docx) — never real content
~$*

# TypeScript incremental build cache
tsconfig.tsbuildinfo

# Next.js
node_modules/
.next/
out/
.vercel/
