# Copy to .env for local development (never commit .env)

# Vercel sets these automatically; enable retrieval-only mode locally if needed:
# VERCEL=1
# UMU_RETRIEVAL_FALLBACK=1

# Local Ollama response phrasing (optional)
OLLAMA_MODEL=umubyeyi
OLLAMA_URL=http://127.0.0.1:11434/api/chat
# Ollama is opt-in so it cannot delay the grounded fallback unexpectedly.
# UMU_ENABLE_OLLAMA=1
OLLAMA_TIMEOUT_SECONDS=8
# Set to 1 to test deterministic retrieval fallback without Ollama
# UMU_DISABLE_OLLAMA=1
# Experimental only; RW Ollama output has not passed the quality gate.
# UMU_ALLOW_RW_OLLAMA=1

# Project-fine-tuned BLOOMZ LoRA generator (enabled by default when the adapter exists)
UMU_FINETUNED_MODEL=models/umubyeyi-bloomz-lora
# UMU_DISABLE_FINETUNED=1

# Groq: general-knowledge wellbeing generation (primary), plus greeting/title text.
# Get a key at https://console.groq.com/keys -- put the real key in .env.local, never here.
GROQ_API_KEY=replace-with-a-new-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=15
# UMU_DISABLE_GROQ=1

# --- Split deployment: Vercel (frontend) + Render (Python API) ---
# Set ONLY in Vercel's project environment variables, never here. Public and
# safe to ship to the browser (NEXT_PUBLIC_* is inlined into the client
# bundle at build time) -- must never hold a secret. Leave unset locally and
# on Vercel if you're not using a separate backend host; every request then
# stays relative and is served same-origin as before.
# NEXT_PUBLIC_API_BASE_URL=https://umubyeyi-1.onrender.com

# Set ONLY on the Render service (the Python API), never on Vercel. Comma-
# separated list of origins allowed to call this API cross-origin. Defaults
# to the two localhost origins if unset, which is correct for local dev but
# not for Render -- set this explicitly there to your real Vercel domain.
# ALLOWED_ORIGINS=https://firstmumassist-six.vercel.app
