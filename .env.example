# Copy to .env for local development (never commit .env)

# Postgres analytics (optional — set in Vercel project Environment Variables)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Vercel sets these automatically; enable retrieval-only mode locally if needed:
# VERCEL=1
# UMU_RETRIEVAL_FALLBACK=1

# Local Ollama response phrasing (optional)
OLLAMA_MODEL=umubyeyi
OLLAMA_URL=http://127.0.0.1:11434/api/chat
# Ollama is opt-in so it cannot delay the grounded fallback unexpectedly.
# UMU_ENABLE_OLLAMA=1
OLLAMA_TIMEOUT_SECONDS=8
# Set to 1 to test deterministic retrieval fallback without Ollama
# UMU_DISABLE_OLLAMA=1
# Experimental only; RW Ollama output has not passed the quality gate.
# UMU_ALLOW_RW_OLLAMA=1

# Project-fine-tuned mT5 LoRA generator (enabled by default when the adapter exists)
UMU_FINETUNED_MODEL=models/umubyeyi-mt5-lora
# UMU_DISABLE_FINETUNED=1

# Optional grounded Gemini fallback. Put the real key in .env.local, never here.
GEMINI_API_KEY=replace-with-a-new-key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=15
# UMU_DISABLE_GEMINI=1
