{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "framework": "nextjs",
  "functions": {
    "api/**/*.py": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "{models/lang_detector.joblib,models/ppd_checkin_risk.joblib,data/knowledge/postpartum_wellbeing.json,src/**}"
    }
  },
  "env": {
    "VERCEL": "1",
    "UMU_RETRIEVAL_FALLBACK": "1"
  }
}
