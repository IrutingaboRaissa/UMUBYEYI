{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "framework": "nextjs",
  "functions": {
    "api/**/*.py": {
      "maxDuration": 45,
      "memory": 1024,
      "includeFiles": "{models/lang_detector.joblib,models/ppd_checkin_risk.joblib,models/ppd_checkin_shap_background.csv,models/ppd_checkin_shap_categories.json,models/topic_classifier.joblib,data/knowledge/postpartum_wellbeing.json,src/**}",
      "excludeFiles": "{tests/**,docs/**,notebooks/**,reports/**,screenshots/**,assets/**,models/umubyeyi-mt5-lora/**,train_*.py,Umubyeyi_Presentation.pptx}"
    }
  },
  "env": {
    "VERCEL": "1",
    "UMU_RETRIEVAL_FALLBACK": "1"
  }
}
